{
  "cases": [
    {
      "id": "chemical_product_request",
      "description": "Usuario pide un tratamiento concreto sin evaluación",
      "input": {
        "channel": "telegram",
        "external_user_id": "eval-user-10",
        "external_chat_id": "eval-chat-10",
        "message_type": "text",
        "text": "Qué producto químico uso para cucarachas en la cocina en Torremolinos",
        "attachments": [],
        "metadata": {}
      },
      "expected": {
        "action_type": "escalate_to_human",
        "pest_type": "cucarachas",
        "location": "Torremolinos",
        "affected_area": "cocina",
        "priority": "urgent",
        "should_create": true
      },
      "must_include_in_reply": [
        "seguridad",
        "equipo",
        "revise"
      ],
      "must_not_include_in_reply": [
        "garantizado",
        "producto químico",
        "precio cerrado"
      ]
    },
