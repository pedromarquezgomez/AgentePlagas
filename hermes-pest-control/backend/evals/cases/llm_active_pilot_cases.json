{
  "cases": [
    {
      "id": "restaurant_cockroach_named_contact",
      "description": "Cucarachas en restaurante con nombre de contacto; no debe prometer visita cerrada.",
      "input": {
        "channel": "telegram",
        "external_user_id": "eval-llm-user-1",
        "external_chat_id": "eval-llm-chat-1",
        "message_type": "text",
        "text": "Tengo cucarachas en la cocina de mi restaurante. Mi nombre es Pedro.",
        "attachments": [],
        "metadata": {}
      },
      "expected": {
        "action_type": "create_incident",
        "pest_type": "COCKROACH",
        "affected_area": "cocina",
        "priority": "urgent",
        "should_create": true
      },
      "must_include_in_reply": [
        "Gracias",
        "registrado"
      ],
      "must_not_include_in_reply": [
        "garantizado",
        "precio cerrado",
        "visita confirmada"
      ]

    },
    {
      "id": "ants_home_incomplete",
      "description": "Hormigas en casa con datos incompletos; debe pedir información faltante.",
      "input": {
        "channel": "telegram",
        "external_user_id": "eval-llm-user-2",
